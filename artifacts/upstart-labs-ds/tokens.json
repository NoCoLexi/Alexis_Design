{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "UpStart-Labs visual identity tokens — sourced from visual-identity.md (2026-08-06). Light-mode is authoritative; dark is derived. Edit here only; the dev server regenerates src/index.css and src/generated/tokens.tsx.",
  "color": {
    "$type": "color",
    "light": {
      "background":             { "$value": "#F7F6F2", "$description": "Paper — page background" },
      "foreground":             { "$value": "#191918", "$description": "Ink — primary text" },
      "border":                 { "$value": "#D2CFC6", "$description": "Line — hairline rules, dividers" },
      "card":                   { "$value": "#FFFFFF", "$description": "White — cards and input surfaces" },
      "cardForeground":         { "$value": "#191918" },
      "popover":                { "$value": "#FFFFFF" },
      "popoverForeground":      { "$value": "#191918" },
      "primary":                { "$value": "#C8380E", "$description": "Orange CTA — buttons, links, bold emphasis" },
      "primaryForeground":      { "$value": "#FFFFFF" },
      "secondary":              { "$value": "#ECE9E1", "$description": "Sand — secondary surface" },
      "secondaryForeground":    { "$value": "#191918" },
      "muted":                  { "$value": "#E3E0D8", "$description": "Soft — tertiary surface, subtle fills" },
      "mutedForeground":        { "$value": "#5F5D57", "$description": "Muted — secondary copy, captions" },
      "accent":                 { "$value": "#F45122", "$description": "Orange — highlights, icons, small emphasis" },
      "accentForeground":       { "$value": "#FFFFFF" },
      "destructive":            { "$value": "#C8380E" },
      "destructiveForeground":  { "$value": "#FFFFFF" },
      "input":                  { "$value": "#D2CFC6" },
      "ring":                   { "$value": "#C8380E" },
      "chart1":                 { "$value": "#F45122" },
      "chart2":                 { "$value": "#5F5D57" },
      "chart3":                 { "$value": "#A09890" },
      "chart4":                 { "$value": "#C8380E" },
      "chart5":                 { "$value": "#656359" },
      "sidebar":                { "$value": "#ECE9E1" },
      "sidebarForeground":      { "$value": "#191918" },
      "sidebarBorder":          { "$value": "#D2CFC6" },
      "sidebarPrimary":         { "$value": "#C8380E" },
      "sidebarPrimaryForeground": { "$value": "#FFFFFF" },
      "sidebarAccent":          { "$value": "#E3E0D8" },
      "sidebarAccentForeground": { "$value": "#191918" },
      "sidebarRing":            { "$value": "#C8380E" }
    },
    "dark": {
      "background":             { "$value": "#191918", "$description": "Ink inverted to background" },
      "foreground":             { "$value": "#F7F6F2", "$description": "Paper as text" },
      "border":                 { "$value": "#3A3936" },
      "card":                   { "$value": "#252523" },
      "cardForeground":         { "$value": "#F7F6F2" },
      "popover":                { "$value": "#252523" },
      "popoverForeground":      { "$value": "#F7F6F2" },
      "primary":                { "$value": "#F45122", "$description": "Brighter orange in dark for visibility" },
      "primaryForeground":      { "$value": "#FFFFFF" },
      "secondary":              { "$value": "#2E2D2B" },
      "secondaryForeground":    { "$value": "#ECE9E1" },
      "muted":                  { "$value": "#333230" },
      "mutedForeground":        { "$value": "#A8A59F" },
      "accent":                 { "$value": "#F45122" },
      "accentForeground":       { "$value": "#FFFFFF" },
      "destructive":            { "$value": "#F45122" },
      "destructiveForeground":  { "$value": "#FFFFFF" },
      "input":                  { "$value": "#3A3936" },
      "ring":                   { "$value": "#F45122" },
      "chart1":                 { "$value": "#F45122" },
      "chart2":                 { "$value": "#A8A59F" },
      "chart3":                 { "$value": "#D2CFC6" },
      "chart4":                 { "$value": "#C8380E" },
      "chart5":                 { "$value": "#7A7873" },
      "sidebar":                { "$value": "#141410" },
      "sidebarForeground":      { "$value": "#F7F6F2" },
      "sidebarBorder":          { "$value": "#3A3936" },
      "sidebarPrimary":         { "$value": "#F45122" },
      "sidebarPrimaryForeground": { "$value": "#FFFFFF" },
      "sidebarAccent":          { "$value": "#2E2D2B" },
      "sidebarAccentForeground": { "$value": "#F7F6F2" },
      "sidebarRing":            { "$value": "#F45122" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans":  { "$value": ["DM Sans", "Arial", "sans-serif"],     "$description": "Body, UI, labels" },
      "serif": { "$value": ["Newsreader", "Georgia", "serif"],      "$description": "Display — headlines, titles" },
      "mono":  { "$value": ["DM Mono", "monospace"],               "$description": "Technical labels, eyebrows, metadata" }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": { "$value": "0.25rem", "$description": "Tight radius — clean, editorial feel" }
  },
  "spacing": {
    "$type": "dimension",
    "base": { "$value": "0.25rem" }
  }
}
